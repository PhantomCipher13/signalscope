# SignalScope — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Supabase (cloud persistence) ──────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Admin authentication ───────────────────────────────────────────────────────
# Used to protect /admin/feedback and /admin/analyses endpoints
# Pass as X-Admin-Token header or ?token= query parameter
ADMIN_TOKEN=change-me-in-production

# ── Inference device ───────────────────────────────────────────────────────────
# auto   → uses DirectML on AMD GPU (Windows), CUDA on Nvidia, else CPU
# cpu    → force CPU inference (required for cloud/Vercel/Linux)
# cuda   → force CUDA (requires Nvidia GPU)
SIGNALSCOPE_DEVICE=auto

# ── Database backend ───────────────────────────────────────────────────────────
# supabase → persist to Supabase + SQLite (recommended for production)
# sqlite   → local SQLite only
SIGNALSCOPE_DB_BACKEND=supabase

# ── Server (optional overrides) ───────────────────────────────────────────────
# SIGNALSCOPE_HOST=0.0.0.0
# SIGNALSCOPE_PORT=8000

# ── Hugging Face (deployment only, never expose in frontend) ──────────────────
# HF_TOKEN=hf_...  (only needed if uploading to HF Hub)
